# Application
PORT=8481
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=rmu_survey_demo

# Authentication
JWT_SECRET=generate-a-long-random-secret

# Frontend URLs
CLIENT_URL=http://localhost:3481
CORS_ORIGINS=http://localhost:3481
SURVEY_BASE_URL=http://localhost:3481

# Resend (recommended for deployment)
RESEND_API_KEY=
RESEND_FROM=RMU Survey Demo <noreply@example.com>
MAIL_FROM=RMU Survey Demo <noreply@example.com>

# SMTP fallback (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
